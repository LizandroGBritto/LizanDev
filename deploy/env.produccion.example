# Variables de producción de dev.lizan.site. Copiar a /var/www/dev.lizan.site/.env
# (propietario lizandev, permisos 600) y completar. NUNCA versionar el .env real.
APP_NAME=LizanDev
APP_ENV=production
APP_KEY=                 # php artisan key:generate --force
APP_DEBUG=false          # con true, una excepción muestra rutas, variables y consultas
APP_URL=https://dev.lizan.site
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lizandev
DB_USERNAME=lizandev
DB_PASSWORD=             # única de este proyecto, no reutilizar

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true

CACHE_STORE=database
QUEUE_CONNECTION=sync

ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=          # larga y única; se puede borrar del .env después de correr el seeder

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MINIMUM_SCORE=0.5
